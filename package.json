{
  "name": "postledger",
  "version": "0.5.1",
  "description": "Double-entry bookkeeping that assumes the bookkeeper is not trustworthy. Idempotent writes, append-only journal, DB-enforced balance, tamper-evident hash chain. Unix CLI + MCP server. Zero dependencies.",
  "keywords": [
    "double-entry",
    "bookkeeping",
    "accounting",
    "ledger",
    "general-ledger",
    "idempotent",
    "idempotency",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "llm",
    "claude",
    "audit-trail",
    "tamper-evident",
    "append-only",
    "benford",
    "sqlite",
    "plaintext-accounting",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "postledger": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/ledger.js",
    "./money": "./dist/money.js",
    "./audit": "./dist/audit.js",
    "./reports": "./dist/reports.js",
    "./interop": "./dist/interop.js"
  },
  "files": [
    "dist/",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node tests/invariants.mjs && node tests/money.mjs && node tests/engine.mjs && node tests/forensics.mjs && node tests/reports.mjs && node tests/assertions.mjs && node tests/operations.mjs && node tests/e2e.mjs",
    "test:invariants": "node tests/invariants.mjs",
    "test:money": "node tests/money.mjs",
    "test:engine": "node tests/engine.mjs",
    "test:forensics": "node tests/forensics.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:reports": "node tests/reports.mjs",
    "build": "tsc && cp src/schema.sql dist/",
    "prepublishOnly": "npm run build && npm test",
    "clean": "rm -rf dist",
    "test:assertions": "node tests/assertions.mjs",
    "test:operations": "node tests/operations.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuaige121/postledger.git"
  },
  "bugs": {
    "url": "https://github.com/shuaige121/postledger/issues"
  },
  "homepage": "https://github.com/shuaige121/postledger#readme",
  "mcpName": "io.github.shuaige121/postledger",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "types": "./dist/ledger.d.ts"
}